FROM maven:3.9-eclipse-temurin-17 AS build
WORKDIR /workspace
COPY pom.xml mvnw ./
COPY .mvn .mvn
COPY CI CI
COPY commerce/maven-settings.xml commerce/maven-settings.xml
COPY data-agent-management data-agent-management
RUN --mount=type=cache,target=/root/.m2 ./mvnw -B -s commerce/maven-settings.xml -pl data-agent-management -DskipTests -Dspotless.skip=true package
FROM eclipse-temurin:17-jre
WORKDIR /app
COPY --from=build /workspace/data-agent-management/target/spring-ai-alibaba-data-agent-management-*.jar app.jar
EXPOSE 8065
ENTRYPOINT ["java", "-jar", "app.jar"]
